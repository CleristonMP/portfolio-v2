{
  "name": "cleriston-portfolio-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host=127.0.0.1 --port=4180 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify": "npm run verify:content && npm run verify:i18n",
    "build:subpath": "tsc -b && vite build --base=/portfolio-v2/ --outDir=.m2-review/m2-08/dist-subpath",
    "preview:subpath": "vite preview --base=/portfolio-v2/ --outDir=.m2-review/m2-08/dist-subpath --host=127.0.0.1 --port=4181 --strictPort"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.16.0 <23"
  }
}
